{
  "name": "stock-market-monorepo",
  "version": "1.0.0",
  "description": "Stock Market Paper Trading Platform Monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "start": "concurrently \"npm run start -w apps/api\" \"npm run start -w apps/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run migrate -w packages/database",
    "db:generate": "npm run generate -w packages/database",
    "db:seed": "npm run seed -w packages/database"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsx": "^4.9.3",
    "rimraf": "^5.0.5",
    "concurrently": "^8.2.2"
  }
}
